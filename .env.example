# Firebase web config for OPTIONAL cross-device sync.
# Copy to `.env` for local dev, or set these as CI/CD build env (GitHub Secrets).
# These are NOT secrets (a Firebase web config is public); security is enforced by
# Firestore rules (users can only read/write users/{their-own-uid}).
# If any are missing at build time, the sync feature is hidden and no Firebase SDK
# is loaded — the app keeps working fully offline as before.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional:
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
