rules_version = '2';

// Security rules for SkinLog cross-device sync.
// Each user owns exactly one document at users/{uid} holding their full state
// ({ version, settings, days, meta }). A user may only read/write their own doc.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
